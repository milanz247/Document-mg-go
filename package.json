{
  "name": "fastify-atlas-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:embed": "node scripts/embed-assets.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:client && npm run build:embed && npm run build:server",
    "start": "node --disable-warning=ExperimentalWarning dist/server.cjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "dompurify": "3.4.13",
    "fastify": "5.12.1",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.19.11",
    "@vitejs/plugin-vue": "6.0.8",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue-tsc": "3.3.10"
  }
}
